# Veri kaynakları
KANDILLI_XML=                # Kandilli canlı XML feed URL'i
KANDILLI_DATE_XML=           # Kandilli arşiv XML taban URL'i (sonuna YYYYMM.xml eklenir)
AFAD_API=                    # AFAD deprem event servisi URL'i

# MongoDB
MONGODB_USER=
MONGODB_PASS=                # özel karakter içeriyorsa olduğu gibi yazın (kod encode eder)
MONGODB_HOST=
MONGODB_PORT=27017

# Anahtarlar
CRON_KEY=                    # /deprem/int/* uçları için Authorization başlığı
STATS_KEY=                   # /deprem/data/stats ve /deprem/data/sitemap uçları için Authorization başlığı

# Rate limit muafiyeti — ZORUNLU: tanımsızsa servis açılmaz. Muaf IP yoksa boş bırakın.
BYPASS_IPS=

# Opsiyonel
REQUEST_TIMEOUT_MS=30000     # istek zaman aşımı (ms)

# Opsiyonel — Cloudflare edge ban (ACCOUNT_ID, API_KEY ve EMAIL doluysa banlanan IP'ler Cloudflare listesine eklenir)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_KEY=
CLOUDFLARE_EMAIL=
CLOUDFLARE_LIST_ID=          # boşsa liste otomatik oluşturulur

# NODE_ENV npm script'leri tarafından ayarlanır (DEV → veritabanı adlarına dev_ öneki)
